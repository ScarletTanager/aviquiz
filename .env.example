# Standalone deployment only. Never put real connection credentials in Git.
DB_DRIVER=postgres
DATABASE_URL=
DATABASE_SSL=verify-full
# Optional PEM CA certificate for the managed database:
DATABASE_CA=
# Alternatively, set DATABASE_CA_FILE to a local PEM certificate path.
DATABASE_POOL_MAX=5

# For local SQLite instead, set DB_DRIVER=sqlite and provide a private writable path:
# SQLITE_PATH=/absolute/private/data/aviquiz.sqlite
# For loopback-only local PostgreSQL tests, DATABASE_SSL=disable is supported.
# Sites continues to use its platform DB binding and defaults to DB_DRIVER=d1.

# Disabled until a narrowly scoped invitation sender is configured server-side.
INVITATIONS_ENABLED=false
# Uses AUTH_ISSUER to select the existing pool; no client-supplied pool is accepted.
# AUTH_ENABLED must also be true. Never put AWS management credentials in browser config.

# Geography metadata only; never expose this key through browser configuration.
# Keep the file protected and readable by the service account.
EBIRD_API_KEY_FILE=
