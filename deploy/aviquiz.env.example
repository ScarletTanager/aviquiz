# Copy to /etc/aviquiz/aviquiz.env with root ownership and mode 0600.
# Supply real database settings privately; never commit credentials.
DB_DRIVER=postgres
DEPLOYMENT_TARGET=standalone
DATABASE_URL=
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=5
DATABASE_CA_FILE=/etc/aviquiz/db-ca.crt
PUBLIC_ORIGIN=https://aviquiz.org

# Enable only after invitation migration, grants, and scoped server authorization.
INVITATIONS_ENABLED=false
