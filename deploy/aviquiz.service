[Unit]
Description=AviQuiz application
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/aviquiz/current/server/http.mjs
ConditionPathExists=/etc/aviquiz/aviquiz.env

[Service]
Type=simple
User=aviquiz
Group=aviquiz
WorkingDirectory=/srv/aviquiz/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=384
EnvironmentFile=/etc/aviquiz/aviquiz.env
ExecStart=/opt/node24/bin/node /srv/aviquiz/current/server/http.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
LimitNOFILE=4096
MemoryHigh=600M
MemoryMax=700M

[Install]
WantedBy=multi-user.target
